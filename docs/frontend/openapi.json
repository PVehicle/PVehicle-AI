{
  "openapi": "3.1.0",
  "info": {
    "title": "PVehicle-AI API",
    "description": "\nREST API cho he thong nhan dien va tu van o to.\n\n## Chuc nang\n\n* **Nhan dien xe** — tai anh len, nhan ve dong xe kem thong so ky thuat\n* **Tra cuu danh muc** — 196 dong xe voi day du thong so\n* **Goi y theo nhu cau** — loc theo ngan sach, so cho, kieu dang\n* **Tim xe tuong tu** — dua tren dac diem cua mot xe cho truoc\n\n## Kien truc nhan dien\n\nHai tang: YOLOv8n khoanh vung xe trong anh, sau do EfficientNet-B0 phan\nloai chi tiet 196 dong xe. Toan bo chay bang ONNX Runtime tren CPU.\n\n## Xac thuc\n\nNeu may chu duoc cau hinh API key, moi request phai kem header\n`X-API-Key`. Cac endpoint `/health` va `/ready` luon mo.\n\n## Luu y ve du lieu\n\nGia ban va muc tieu hao nhien lieu la **so lieu mo phong**, khong phai gia\nthi truong that. Xem `docs/car_specs_generation.md`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Kiem tra tien trinh con song. Luon tra 200 neu may chu con chay.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "Kiem tra da san sang phuc vu chua.\n\nTra 503 khi chua nap duoc mo hinh nhan dien, de bo can bang tai khong\ndinh tuyen request vao ban sao nay.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recognize": {
      "post": {
        "tags": [
          "recognition"
        ],
        "summary": "Nhan dien dong xe tu anh",
        "description": "Nhan dien cac dong xe co trong anh.\n\nLuong xu ly: YOLOv8 khoanh vung xe → crop → phan loai 196 lop → tra\nve top-k kha nang kem thong so ky thuat.\n\nNeu khong phat hien duoc xe nao, he thong phan loai toan bo buc anh\nva danh dau `box = null`.",
        "operationId": "recognize_api_v1_recognize_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 5,
              "title": "Top K"
            }
          },
          {
            "name": "include_similar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Tra kem cac xe tuong tu",
              "default": false,
              "title": "Include Similar"
            },
            "description": "Tra kem cac xe tuong tu"
          },
          {
            "name": "similar_count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 3,
              "title": "Similar Count"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_recognize_api_v1_recognize_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionResponse"
                }
              }
            }
          },
          "400": {
            "description": "File rong hoac anh hong"
          },
          "413": {
            "description": "File hoac anh qua lon"
          },
          "415": {
            "description": "Dinh dang khong duoc ho tro"
          },
          "503": {
            "description": "Mo hinh nhan dien chua san sang"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
