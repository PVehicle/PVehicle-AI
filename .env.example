# Cau hinh REST API — chep file nay thanh `.env` roi sua gia tri.
#
# File `.env` da bi .gitignore chan, KHONG BAO GIO commit no len git.
# Moi bien deu co tien to PVEHICLE_.

# ---------------------------------------------------------------------
# Bao mat
# ---------------------------------------------------------------------

# Danh sach API key hop le, ngan cach bang dau phay.
# De TRONG thi API mo cong khai — chi dung khi phat trien tren may minh.
#
# Sinh key ngau nhien:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PVEHICLE_API_KEYS=

# Cac origin duoc phep goi tu trinh duyet (CORS), ngan cach bang dau phay.
# Dung "*" khi phat trien, nhung khi trien khai that phai ghi ro ten mien.
PVEHICLE_CORS_ORIGINS=*

# ---------------------------------------------------------------------
# Gioi han dau vao
# ---------------------------------------------------------------------

# Kich thuoc file toi da (byte). Mac dinh 10 MB.
PVEHICLE_MAX_UPLOAD_BYTES=10485760

# So diem anh toi da, chan anh do phan giai qua cao lam can bo nho.
# Mac dinh 50 trieu (khoang 7000x7000).
PVEHICLE_MAX_IMAGE_PIXELS=50000000

# ---------------------------------------------------------------------
# Gioi han toc do
# ---------------------------------------------------------------------

# Dinh dang: "<so lan>/<don vi>" — vi du 60/minute, 1000/hour.
PVEHICLE_RATE_LIMIT_DEFAULT=60/minute
PVEHICLE_RATE_LIMIT_RECOGNIZE=20/minute

# ---------------------------------------------------------------------
# Suy luan
# ---------------------------------------------------------------------

# So pipeline chay song song. Moi pipeline giu session ONNX rieng va ton
# khoang 30 MB RAM. ONNX Runtime KHONG an toan da luong nen khong duoc
# dung chung mot session cho nhieu request.
#
# Nen dat bang so nhan CPU, toi da 4 tren may thong thuong.
PVEHICLE_INFERENCE_WORKERS=2

# Nguong tin cay cua tang phat hien xe (0.0 - 1.0).
PVEHICLE_DETECTION_CONFIDENCE=0.35

# So du doan tra ve mac dinh cho moi xe.
PVEHICLE_DEFAULT_TOP_K=5

# ---------------------------------------------------------------------
# Khac
# ---------------------------------------------------------------------

# Bat che do go loi (in nhieu log hon). Khong bat khi chay that.
PVEHICLE_DEBUG=false
